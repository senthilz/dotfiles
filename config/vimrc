let lspServers = [#{
            \    name: 'golang',
            \    filetype: ['go', 'gomod'],
            \    path: '/home/ubuntu/go/bin/gopls',
            \    args: ['serve'],
            \ }]
autocmd User LspSetup call LspAddServer(lspServers)

