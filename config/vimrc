" ===============================
" Bootstrap vim-plug Installation
" ===============================
if empty(glob(expand('~/.vim/autoload/plug.vim')))
  " Create the ~/.vim/autoload directory if it doesn't exist
  call mkdir(expand('~/.vim/autoload'), 'p')

  " Download vim-plug, if failed run the curl manually
  echo "Installing vim-plug..."
  silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
      https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

  " Reload vim-plug after installation
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" ===============================
" Plugin Management (Using vim-plug)
